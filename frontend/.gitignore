# =============================================================================
# shiftLK-web — Next.js Frontend .gitignore
# =============================================================================

# Dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Next.js build output
/.next/
/out/
/build/

# Production bundles
dist/

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment variables — keep .env.example, ignore all real env files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow: .env.example is safe to commit

# Testing & coverage
/coverage/
/.nyc_output/

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
*.log

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# Vercel deployment
.vercel/

# Misc
*.pem
.cache/
