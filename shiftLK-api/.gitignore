# =============================================================================
# shiftLK-api — Express + Prisma Backend .gitignore
# =============================================================================

# Dependencies
node_modules/

# Build output
dist/

# Environment variables — .env.example is safe to commit, all others are not
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# Allow: .env.example

# Prisma — keep migrations committed, ignore generated client
node_modules/.prisma/

# Uploaded user files — only keep the placeholder
uploads/*
!uploads/.gitkeep

# Logs
*.log
logs/
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Testing & coverage
/coverage/
/.nyc_output/

# OS files
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db

# Editor files
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# TypeScript
*.tsbuildinfo

# Misc
*.pem
.cache/
