# ShiftLK Spares Configuration

# Public Site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Business WhatsApp Phone Number (country code 94 without + or leading 0, e.g. 94770871018)
NEXT_PUBLIC_WHATSAPP_NUMBER=94770871018

# Optional: Supabase Database Configuration
# If left blank or unconfigured, the application runs seamlessly using built-in high-performance mock/seed database
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Private Admin Service Role Key (for future admin panel, NEVER exposed to browser)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
