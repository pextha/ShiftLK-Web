generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  STAFF
}

enum ProductCondition {
  NEW
  RECONDITIONED
  USED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ExpenseCategory {
  INVENTORY
  SHIPPING
  SALARY
  UTILITY
  RENT
  MARKETING
  OTHER
}

enum StockMovementReason {
  RESTOCK
  ORDER_CONFIRMED
  ORDER_CANCELLED
  MANUAL_ADJUSTMENT
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique @db.VarChar(191)
  name         String     @db.VarChar(191)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  role         Role       @default(STAFF)
  isActive     Boolean    @default(true) @map("is_active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  expenses       Expense[]
  auditLogs      AuditLog[]
  stockMovements StockMovement[]

  @@map("users")
}

model Category {
  id           String                @id @default(cuid())
  slug         String                @unique @db.VarChar(191)
  icon         String                @default("Wrench") @db.VarChar(50)
  displayOrder Int                   @default(0) @map("display_order")
  isActive     Boolean               @default(true) @map("is_active")
  createdAt    DateTime              @default(now()) @map("created_at")
  updatedAt    DateTime              @updatedAt @map("updated_at")

  translations CategoryTranslation[]
  products     Product[]

  @@index([slug])
  @@index([isActive])
  @@map("categories")
}

model CategoryTranslation {
  id          String   @id @default(cuid())
  categoryId  String   @map("category_id")
  language    String   @db.VarChar(5)
  name        String   @db.VarChar(255)
  description String?  @db.Text

  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, language])
  @@index([categoryId])
  @@map("category_translations")
}

model Brand {
  id        String    @id @default(cuid())
  slug      String    @unique @db.VarChar(191)
  name      String    @db.VarChar(191)
  country   String?   @db.VarChar(100)
  isActive  Boolean   @default(true) @map("is_active")
  createdAt DateTime  @default(now()) @map("created_at")

  products  Product[]

  @@index([slug])
  @@map("brands")
}

model Product {
  id              String                 @id @default(cuid())
  slug            String                 @unique @db.VarChar(191)
  partNumber      String                 @map("part_number") @db.VarChar(100)
  brandId         String                 @map("brand_id")
  categoryId      String                 @map("category_id")
  condition       ProductCondition       @default(NEW)
  sellingPrice    Decimal                @map("selling_price") @db.Decimal(10, 2)
  costPrice       Decimal                @map("cost_price") @db.Decimal(10, 2)
  stockQty        Int                    @default(0) @map("stock_qty")
  lowStockThreshold Int                  @default(5) @map("low_stock_threshold")
  weightKg        Decimal                @default(1.000) @map("weight_kg") @db.Decimal(6, 3)
  isActive        Boolean                @default(true) @map("is_active")
  createdAt       DateTime               @default(now()) @map("created_at")
  updatedAt       DateTime               @updatedAt @map("updated_at")

  category        Category               @relation(fields: [categoryId], references: [id])
  brand           Brand                  @relation(fields: [brandId], references: [id])
  translations    ProductTranslation[]
  images          ProductImage[]
  compatibilities VehicleCompatibility[]
  orderItems      OrderItem[]
  stockMovements  StockMovement[]

  @@index([slug])
  @@index([categoryId])
  @@index([brandId])
  @@index([sellingPrice])
  @@index([stockQty])
  @@index([lowStockThreshold])
  @@index([isActive])
  @@index([createdAt])
  @@map("products")
}

model ProductTranslation {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  language    String   @db.VarChar(5)
  name        String   @db.VarChar(500)
  description String   @db.Text

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, language])
  @@index([productId])
  @@map("product_translations")
}

model ProductImage {
  id           String   @id @default(cuid())
  productId    String   @map("product_id")
  imageUrl     String   @map("image_url") @db.VarChar(1000)
  displayOrder Int      @default(0) @map("display_order")
  isPrimary    Boolean  @default(false) @map("is_primary")

  product      Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_images")
}

model VehicleCompatibility {
  id          String   @id @default(cuid())
  productId   String   @map("product_id")
  make        String   @db.VarChar(100)
  model       String   @db.VarChar(100)
  yearFrom    Int      @map("year_from")
  yearTo      Int?     @map("year_to")
  chassisCode String?  @map("chassis_code") @db.VarChar(50)

  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([make, model])
  @@index([productId])
  @@map("vehicle_compatibilities")
}

model DeliveryZone {
  id            String   @id @default(cuid())
  district      String   @unique @db.VarChar(100)
  province      String   @db.VarChar(100)
  baseFee       Decimal  @default(425.00) @map("base_fee") @db.Decimal(10, 2)
  extraPerKg    Decimal  @default(100.00) @map("extra_per_kg") @db.Decimal(10, 2)
  estimatedDays String   @default("1-3 Days") @map("estimated_days") @db.VarChar(100)
  isActive      Boolean  @default(true) @map("is_active")

  @@index([district])
  @@index([isActive])
  @@map("delivery_zones")
}

model Order {
  id               String      @id @default(cuid())
  orderCode        String      @unique @map("order_code") @db.VarChar(50)
  customerName     String      @map("customer_name") @db.VarChar(255)
  phone            String      @db.VarChar(30)
  address          String      @db.Text
  district         String      @db.VarChar(100)
  deliveryCost     Decimal     @map("delivery_cost") @db.Decimal(10, 2)
  subtotal         Decimal     @db.Decimal(10, 2)
  total            Decimal     @db.Decimal(10, 2)
  status           OrderStatus @default(PENDING)
  customerLanguage String      @default("en") @map("customer_language") @db.VarChar(5)
  notes            String?     @db.Text
  adminNotes       String?     @map("admin_notes") @db.Text
  trackingNumber   String?     @map("tracking_number") @db.VarChar(100)
  createdAt        DateTime    @default(now()) @map("created_at")
  updatedAt        DateTime    @updatedAt @map("updated_at")

  items            OrderItem[]

  @@index([orderCode])
  @@index([phone])
  @@index([status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String   @map("order_id")
  productId String   @map("product_id")
  qty       Int
  unitPrice Decimal  @map("unit_price") @db.Decimal(10, 2)
  unitCost  Decimal  @map("unit_cost") @db.Decimal(10, 2)

  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model OrderCounter {
  id         String   @id @default("default") @db.VarChar(20)
  lastNumber Int      @default(123) @map("last_number")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@map("order_counters")
}

model Expense {
  id          String          @id @default(cuid())
  type        ExpenseCategory
  amount      Decimal         @db.Decimal(10, 2)
  date        DateTime        @default(now())
  note        String?         @db.Text
  createdById String?         @map("created_by_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  createdBy   User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)

  @@index([type])
  @@index([date])
  @@map("expenses")
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?  @map("user_id")
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(50)
  entityId   String   @map("entity_id") @db.VarChar(100)
  oldValues  String?  @map("old_values") @db.Text
  newValues  String?  @map("new_values") @db.Text
  ipAddress  String?  @map("ip_address") @db.VarChar(45)
  createdAt  DateTime @default(now()) @map("created_at")

  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model StockMovement {
  id         String              @id @default(cuid())
  productId  String              @map("product_id")
  changeQty  Int                 @map("change_qty")
  reason     StockMovementReason
  note       String?             @db.Text
  userId     String?             @map("user_id")
  createdAt  DateTime            @default(now()) @map("created_at")

  product    Product             @relation(fields: [productId], references: [id], onDelete: Cascade)
  user       User?               @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([createdAt])
  @@map("stock_movements")
}

model SystemSetting {
  id                  String   @id @default("default") @db.VarChar(50)
  defaultLowStockAlert Int      @default(5) @map("default_low_stock_alert")
  whatsappNumber      String   @default("+94771234567") @map("whatsapp_number") @db.VarChar(50)
  hideProfitFromStaff Boolean  @default(false) @map("hide_profit_from_staff")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}
